DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL local
POSTGRES_DB=gestion_academica_local
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_SSLMODE=prefer

# PostgreSQL cloud preparation (Azure Database for PostgreSQL Flexible Server)
# Use these values in a real .env file when connecting to Azure.
# Do not commit real credentials.
AZURE_POSTGRES_DB=gestion_academica
AZURE_POSTGRES_USER=app_user
AZURE_POSTGRES_PASSWORD=change-me
AZURE_POSTGRES_HOST=your-server-name.postgres.database.azure.com
AZURE_POSTGRES_PORT=5432
AZURE_POSTGRES_SSLMODE=require
